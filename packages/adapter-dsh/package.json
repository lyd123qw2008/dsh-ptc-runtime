{
  "name": "@lyd123qw2008/dsh-ptc-dsh-adapter",
  "version": "0.1.0",
  "description": "The two-tool DSH face (`cap_help` / `cap_call`) for the PTC capability runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ptc",
    "mcp",
    "dsh",
    "deepseek-harness",
    "code-mode",
    "tool-facade"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@lyd123qw2008/dsh-ptc-runtime": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@types/node": "^22.20.0",
    "vitest": "^4.1.8"
  }
}
